<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Shared with the App Intent, keyboard and share extensions (ARCHITECTURE §6).
      Identity and pairing records live in the Keychain access group so an extension can
      beam without the container app ever launching — which is the entire point of the
      Action Button flow.
    -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)group.com.narrion.airclip</string>
    </array>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.narrion.airclip</string>
    </array>
</dict>
</plist>
